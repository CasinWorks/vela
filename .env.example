# Production subdomains on casinworks.com
VITE_PARENT_URL=https://vela.casinworks.com
VITE_AVIATION_URL=https://aviation.casinworks.com
VITE_CONCIERGE_URL=https://concierge.casinworks.com

# Vela Concierge staff RBAC demo (concierge app only)
VITE_OWNER_EMAIL=owner@vela.studio
VITE_OWNER_PASSWORD=change-me
VITE_ADMIN_EMAIL=admin@vela.studio
VITE_ADMIN_PASSWORD=admin
VITE_DISPATCHER_EMAIL=dispatch@vela.studio
VITE_DISPATCHER_PASSWORD=change-me

# Optional booking emails (server env for apps/concierge — not VITE_)
# Leave unset for a UI-only demo.
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=studio@casinworks.com
BOOKING_FROM_EMAIL=beth.t@example.com
BOOKING_FROM_NAME=Vela Concierge
